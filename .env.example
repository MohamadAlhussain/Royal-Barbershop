# Ohne diese Variablen läuft die Website im Demo-Modus:
# keine Speicherung, kein E-Mail-Versand, Admin-Bereich deaktiviert.

# Echten Buchungsbetrieb aktivieren (nur zusammen mit den Redis-Zugangsdaten wirksam)
BOOKING_MODE=live

# Upstash Redis (Terminspeicher)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin-Bereich
ADMIN_PASSWORD=
# Zufälliger Schlüssel mit mindestens 32 Zeichen, z. B.: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# SMTP für Bestätigungs- und Storno-E-Mails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Kontaktdaten in den E-Mails (optional)
SALON_PHONE=
SALON_EMAIL=
SITE_URL=
